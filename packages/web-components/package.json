{
  "name": "@zebra-design-system/web-components",
  "version": "0.8.2",
  "description": "Zebra Design System \u2014 web components and the CSS-variable token layer they theme from",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "custom-elements.json",
    "AGENTS.md",
    "llms.txt",
    "DESIGN.md",
    "skills",
    "bin"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./components/*": "./dist/components/*",
    "./tokens.css": "./dist/tokens/index.css",
    "./tokens/*": "./dist/tokens/*",
    "./custom-elements.json": "./custom-elements.json"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens-css.mjs",
    "analyze": "cem analyze --litelement --globs \"src/**/*.ts\"",
    "prebuild": "pnpm run tokens && pnpm run analyze",
    "build": "pnpm run prebuild && tsc && cp -R src/tokens dist/tokens",
    "storybook": "pnpm run tokens && storybook dev -p 6007",
    "storybook:build": "pnpm run tokens && storybook build",
    "typecheck": "tsc --noEmit",
    "check:theming": "node scripts/check-theming.mjs",
    "check": "pnpm run tokens && pnpm run typecheck && pnpm run check:theming"
  },
  "dependencies": {
    "@zebra-design-system/icons": "workspace:*",
    "@zebra-design-system/patterns": "workspace:*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-docs": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/web-components": "^8.6.18",
    "@storybook/web-components-vite": "^8.6.18",
    "storybook": "^8.6.18",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multiplayer-studio/zebra-design-system.git",
    "directory": "packages/web-components"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "zebra-skills": "./bin/install-skills.mjs"
  }
}
