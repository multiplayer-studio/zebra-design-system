  "issues": [
    {
      "severity": "warn",
      "source": "gaps",
      "detail": "The file holds no flag artwork. The Flag instance is the flag glyph, so a real flag needs assets this page does not have."
    },
    {
      "severity": "warn",
      "source": "metadata vs structure",
      "detail": "Flag is in the Property Breakdown, but Figma has no such property. Its emoji and artwork values exist only in the metadata."
    },
    {
      "severity": "warn",
      "source": "metadata vs structure",
      "detail": "The metadata says the error stays on while a person corrects it. Input / Phone has no invalid and focused state, because typing and focus replace invalid."
    },
    {
      "severity": "warn",
      "source": "metadata vs structure",
      "detail": "The Content row says the label marks required or optional, and Layout names block. Neither is a property or a Property Breakdown row."
    },
    {
      "severity": "warn",
      "source": "structure (gaps)",
      "detail": "The menu's distance from the control is a raw 8 on an absolute layer, because Figma cannot bind it. The metadata says space/sm."
    },
    {
      "severity": "warn",
      "source": "structure",
      "detail": "open is drawn at medium, default state and default flavour only, in rounded and sharp. There is no full open variant, so the menu's radius on full is unspecified."
    },
    {
      "severity": "warn",
      "source": "structure",
      "detail": "_Phone Country defaults to large and sharp, while Phone Input and Input / Phone default to medium and rounded. A fresh instance of the part will not match its parent."
    },
    {
      "severity": "note",
      "source": "structure",
      "detail": "Phone Input has 83 variants: the full 81 of state, size, shape and flavour, plus the two open ones."
    },
    {
      "severity": "note",
      "source": "structure",
      "detail": "On gradient, an invalid assembly uses the country control's default flavour, so it goes neutral. On ghost the control stays ghost beside the error field."
    },
    {
      "severity": "note",
      "source": "structure",
      "detail": "Ghost's stroke/base resolves to zero, so hover, selected, typing and read-only change a stroke that draws nothing. Input's spec records the same."
    },
    {
      "severity": "note",
      "source": "structure",
      "detail": "The gradient border on enabled and filled is a gradient paint from the Input family, not a single token."
    },
    {
      "severity": "note",
      "source": "metadata",
      "detail": "control/icon-md is named by the metadata and belongs to the nested Icon, so this page binds it through Size=medium."
    },
    {
      "severity": "note",
      "source": "metadata",
      "detail": "Phone Input's description still calls it experimental and carries escaped apostrophes, such as Input&amp;#39;s. Input / Phone and _Phone Country have no description."
    },
    {
      "severity": "note",
      "source": "metadata",
      "detail": "No motion, by the metadata's own statement. The Do and Don't picture areas are empty. Layout has no colour or theming row, so scope behaviour and portalContainer are unstated."
    }
  ]
