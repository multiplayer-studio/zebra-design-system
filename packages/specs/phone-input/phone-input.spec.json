  "behavior": [
    {
      "type": "Motion",
      "description": "No transition is defined."
    },
    {
      "type": "Grouping",
      "description": "Digits group by the country's format as they are typed, and the caret stays with its digit. Grouping is visual: it does not check that a number exists."
    },
    {
      "type": "Length",
      "description": "Digits stop at the format's length. Without a format they stop at the E.164 limit."
    },
    {
      "type": "Country",
      "description": "Picking a country changes the dial code and format, and keeps the digits. Extra digits are dropped."
    },
    {
      "type": "Value",
      "description": "value is the national digits. onValueChange also gives the E.164 number, and name submits it."
    },
    {
      "type": "Dropdown",
      "description": "The country control is the Template/Dropdown trigger. The menu opens below it, left aligned, space/sm away, with one row per country. It scrolls past eight rows."
    },
    {
      "type": "Keyboard",
      "description": "Enter or Space opens the menu. Arrow keys move through the rows. Escape closes it and returns focus to the control."
    },
    {
      "type": "Flags",
      "description": "Code uses the system's emoji flag unless a country passes flag. Pass artwork where flags must show everywhere, because Windows has no emoji flags. Artwork replaces the emoji in the control and every row."
    },
    {
      "type": "Portal",
      "description": "Figma only: the menu is drawn inside the component. In code it mounts in a portal and is positioned against the control, with collision handling."
    }
  ],
  "content": [
    {
      "property": "Label",
      "type": "Input Label, parent owned",
      "description": "The field's name. It marks required or optional, like Input."
    },
    {
      "property": "Country control",
      "type": "_Phone Country, parent owned",
      "description": "The flag and a chevron, joined to the number. It has no visible text, so countryLabel names it."
    },
    {
      "property": "Flag",
      "type": "Flag instance, exposed",
      "description": "Takes real flag artwork. Figma only: the default is the flag glyph as a placeholder, so swap in a flag component wherever the real flag matters. In code, pass flag on a country."
    },
    {
      "property": "Number",
      "type": "Input / Phone, parent owned",
      "description": "The dial code and digits. Dial Code is fixed text that reads with the value."
    },
    {
      "property": "Hint",
      "type": "Input Hint, parent owned",
      "description": "The supporting line, and the reason when invalid."
    },
    {
      "property": "Country menu",
      "type": "Dropdown Menu, parent owned",
      "description": "One Menu Item per country, with its flag and dial code. The selected country takes the selected row."
    },
    {
      "property": "Sample digits",
      "type": "Figma only",
      "description": "The number, dial code and two menu rows are sample content, not API."
    }
  ],
  "usage": {
    "do": [
      "Use real flag artwork in the product. Pass flag on each country, or swap the exposed Flag instance in a design.",
      "Pair it with validation, and set invalid with the reason in the hint. Grouping alone does not prove a number exists."
    ],
    "dont": [
      "Don't ship the flag glyph as the real thing. It is a placeholder, and it says nothing about the country.",
      "Don't use the flag as the only sign of the country. The dial code and the country's name in the menu carry it too."
    ]
  },
  "accessibility": [
    "The label names the number, and the hint is tied to it.",
    "The country control has no visible text, so countryLabel names it, with the selected country and dial code following.",
    "Flags are decorative and hidden from assistive tech, whether emoji or artwork.",
    "Opening the menu moves focus into it, and Escape returns it to the control.",
    "The number uses a tel input mode and tel-national autocomplete.",
    "Invalid is not colour alone, because the hint gives the reason."
  ],
