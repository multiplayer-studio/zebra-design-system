{
  "name": "@zebra-design-system/zeta-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/zeta-web/src",
  "projectType": "library",
  "tags": [
    "release",
    "platform:web"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-script",
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "script": "build"
      }
    },
    "test": {
      "executor": "nx:run-script",
      "options": {
        "script": "test"
      }
    },
    "lint": {
      "executor": "nx:run-script",
      "options": {
        "script": "lint"
      }
    },
    "pack": {
      "executor": "nx:run-script",
      "dependsOn": [
        "build"
      ],
      "outputs": [
        "{projectRoot}/dist/artifacts"
      ],
      "options": {
        "script": "pack"
      }
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "options": {
        "packageRoot": "{projectRoot}"
      }
    }
  }
}
