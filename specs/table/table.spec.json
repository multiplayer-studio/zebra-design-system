  "content": [
    {
      "property": "Controls bar",
      "type": "Table Controls instance",
      "description": "Holds a search field (instance of the search component) fixed to its own Shape, Size and Flavour, and an open Controls Slot for whatever actions a consumer adds. Whether each shows on its own is not reachable from Table, only hasControl toggles them together."
    },
    {
      "property": "Content",
      "type": "Table Content instance",
      "description": "Always the plain left-to-right column layout. Table Content also offers a frozen-column and a horizontally scrolling arrangement, neither used by this instance and neither exposed as a property of Table."
    },
    {
      "property": "Footer",
      "type": "Table Footer instance",
      "description": "Holds a locked summary text and a Pagination instance set to Outline. Whether each shows on its own is not reachable from Table, only hasFooter toggles them together."
    }
  ],
  "usage": {
    "do": [
      "Turn hasControl off when the table doesn't need its own search or extra actions above it.",
      "Turn hasFooter off for a table short enough that pagination has nothing to do."
    ],
    "dont": [
      "Don't expect Table's own properties to hide just the search field or just the pagination summary on their own, hasControl and hasFooter each toggle their whole section together.",
      "Don't expect a frozen or horizontally scrolling column arrangement from this instance, it always uses the plain left-to-right layout no matter what fills the columns."
    ]
  },
  "accessibility": [
    "Nothing in this file marks keyboard navigation between cells, rows or the controls above and below them. Whether this table participates in a grid-style keyboard pattern needs confirming outside Figma."
