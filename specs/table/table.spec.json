  "summary": "A data table with rows of content arranged in columns, framed by an optional controls bar above and a pagination footer below. Reading top to bottom it is the controls bar, the table content, and the footer, each of the two outer bars removable on its own without affecting the other. This instance always lays out its columns in the plain left-to-right arrangement, not the frozen or horizontally scrolling arrangement Table Content also offers.",
  "api": {
    "hasControl": {
      "type": "boolean",
      "figmaName": "hasControl#6717:0",
      "default": true,
      "controls": [
        "controls"
      ],
      "intent": {
        "true": "Shows the controls bar above the content, holding the search field and the controls slot. Turn it off when the table doesn't need its own search or extra actions above it.",
        "false": "Removes the controls bar entirely, the content starts at the top of the table."
      }
    },
    "hasFooter": {
      "type": "boolean",
      "figmaName": "hasFooter#6717:1",
      "default": true,
      "controls": [
        "footer"
      ],
      "intent": {
        "true": "Shows the footer below the content, holding the page summary text and the pagination control. Turn it off for a table short enough that pagination has nothing to do.",
        "false": "Removes the footer entirely, the content ends at the bottom of the table."
      }
    },
    "shape": {
      "type": "enum",
      "figmaName": "Shape",
      "values": [
        "rounded",
        "sharp"
      ],
      "default": "rounded",
      "controls": [
        "root.radius",
        "root.clips",
        "controls.search.shape",
        "controls.controlsSlot (Icon Button shape)",
        "cells (Button, Checkbox shape; Status Label rounded)",
        "footer.pagination.rounded"
      ],
      "intent": {
        "rounded": "Every component inside the table takes its rounded option: search, buttons, checkboxes, status labels and pagination, including the table's own corners.",
        "sharp": "Every component inside the table takes its sharp option."
      },
      "_note": "Rounds the table's outer corners (clipping its content) and sets the matching shape option on every nested component."
    }
  },
