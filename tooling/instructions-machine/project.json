{
  "name": "@zebra-design-system/instructions-machine",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "tags": [
    "private",
    "internal"
  ],
  "targets": {
    "generate": {
      "executor": "nx:run-script",
      "cache": false,
      "options": {
        "script": "generate"
      }
    },
    "selfcheck": {
      "executor": "nx:run-script",
      "cache": false,
      "options": {
        "script": "selfcheck"
      }
    },
    "typecheck": {
      "executor": "nx:run-script",
      "cache": true,
      "options": {
        "script": "typecheck"
      }
    },
    "test": {
      "executor": "nx:run-script",
      "cache": false,
      "options": {
        "script": "test"
      }
    }
  }
}
