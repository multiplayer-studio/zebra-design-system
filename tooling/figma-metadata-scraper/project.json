{
  "name": "@zebra-design-system/figma-metadata-scraper",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "tags": [
    "private",
    "internal"
  ],
  "targets": {
    "scrape": {
      "executor": "nx:run-script",
      "cache": false,
      "options": {
        "script": "scrape"
      }
    },
    "selfcheck": {
      "executor": "nx:run-script",
      "cache": false,
      "options": {
        "script": "selfcheck"
      }
    },
    "typecheck": {
      "executor": "nx:run-script",
      "cache": true,
      "options": {
        "script": "typecheck"
      }
    }
  }
}
