{
  "color": {
    "background": { "$type": "color", "$value": "{color.core.gray-900}" },
    "text": { "$type": "color", "$value": "{color.core.gray-100}" },
    "primary": { "$type": "color", "$value": "{color.core.purple-300}" }
  },
  "spacing": {
    "xs": { "$type": "dimension", "$value": "{spacing.scale.2}" },
    "sm": { "$type": "dimension", "$value": "{spacing.scale.4}" },
    "md": { "$type": "dimension", "$value": "{spacing.scale.12}" },
    "lg": { "$type": "dimension", "$value": "{spacing.scale.16}" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "{radius.scale.0}" },
    "minimal": { "$type": "dimension", "$value": "{radius.scale.s}" },
    "rounded": { "$type": "dimension", "$value": "{radius.scale.m}" },
    "large": { "$type": "dimension", "$value": "{radius.scale.l}" },
    "xl": { "$type": "dimension", "$value": "{radius.scale.xl}" },
    "full": { "$type": "dimension", "$value": "{radius.scale.4xl}" }
  },
  "font": {
    "body": {
      "family": { "$type": "fontFamily", "$value": "{font.family.serif}" },
      "size": { "$type": "dimension", "$value": "{font.size.base}" }
    },
    "heading": {
      "family": { "$type": "fontFamily", "$value": "{font.family.serif}" },
      "size": { "$type": "dimension", "$value": "{font.size.lg}" }
    }
  }
}
