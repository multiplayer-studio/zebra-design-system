{
  "color": {
    "core": {
      "white": { "$type": "color", "$value": "#ffffff" },
      "black": { "$type": "color", "$value": "#000000" },
      "gray-100": { "$type": "color", "$value": "#f3f4f6" },
      "gray-900": { "$type": "color", "$value": "#111827" },
      "blue-300": { "$type": "color", "$value": "#93c5fd" },
      "blue-500": { "$type": "color", "$value": "#3b82f6" },
      "purple-300": { "$type": "color", "$value": "#d8b4fe" },
      "purple-500": { "$type": "color", "$value": "#a855f7" }
    }
  },
  "spacing": {
    "scale": {
      "2": { "$type": "dimension", "$value": "2px" },
      "4": { "$type": "dimension", "$value": "4px" },
      "8": { "$type": "dimension", "$value": "8px" },
      "12": { "$type": "dimension", "$value": "12px" },
      "16": { "$type": "dimension", "$value": "16px" },
      "24": { "$type": "dimension", "$value": "24px" }
    }
  },
  "radius": {
    "scale": {
      "0": { "$type": "dimension", "$value": "0px" },
      "s": { "$type": "dimension", "$value": "4px" },
      "m": { "$type": "dimension", "$value": "8px" },
      "l": { "$type": "dimension", "$value": "16px" },
      "xl": { "$type": "dimension", "$value": "24px" },
      "2xl": { "$type": "dimension", "$value": "32px" },
      "3xl": { "$type": "dimension", "$value": "128px" },
      "4xl": { "$type": "dimension", "$value": "360px" }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": "Inter, system-ui, sans-serif" },
      "serif": { "$type": "fontFamily", "$value": "Georgia, serif" },
      "mono": { "$type": "fontFamily", "$value": "monospace" }
    },
    "size": {
      "sm": { "$type": "dimension", "$value": "14px" },
      "base": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "20px" },
      "xl": { "$type": "dimension", "$value": "24px" }
    }
  }
}
