{
  "name": "@zebra-design-system/token-machine",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "tags": [
    "private",
    "internal"
  ],
  "targets": {
    "clean": {
      "executor": "nx:run-script",
      "cache": false,
      "options": {
        "script": "clean"
      }
    },
    "fetch": {
      "executor": "nx:run-script",
      "cache": false,
      "options": {
        "script": "fetch"
      }
    },
    "convert": {
      "executor": "nx:run-script",
      "dependsOn": [
        "fetch"
      ],
      "cache": false,
      "options": {
        "script": "convert"
      }
    },
    "build": {
      "executor": "nx:run-script",
      "inputs": [
        "{projectRoot}/source/dtcg-tokens/**/*",
        "{projectRoot}/build-tokens/**/*",
        "{projectRoot}/config.json"
      ],
      "outputs": [
        "{workspaceRoot}/packages/foundations/tokens/dist/css",
        "{workspaceRoot}/packages/foundations/tokens/dist/js",
        "{workspaceRoot}/packages/foundations/tokens/dist/json",
        "{workspaceRoot}/packages/foundations/tokens/dist/artifacts"
      ],
      "cache": true,
      "options": {
        "script": "build"
      }
    },
    "artifact": {
      "executor": "nx:run-script",
      "cache": false,
      "outputs": [
        "{workspaceRoot}/packages/foundations/tokens/dist/artifacts"
      ],
      "options": {
        "script": "artifact"
      }
    },
    "typecheck": {
      "executor": "nx:run-script",
      "cache": true,
      "options": {
        "script": "typecheck"
      }
    },
    "test": {
      "executor": "nx:run-script",
      "cache": false,
      "options": {
        "script": "test"
      }
    }
  }
}
