{
  "directories": {
    "tokenRootDir": "./source",
    "tokenDir": "./source/dtcg-tokens",
    "inputFile": "./source/raw-tokens.json",
    "tempDir": "../../packages/foundations/tokens/dist/temp",
    "resolvedFragmentsDir": "../../packages/foundations/tokens/dist/resolved-fragments",
    "cssOutputDir": "../../packages/foundations/tokens/dist/css",
    "jsonOutputDir": "../../packages/foundations/tokens/dist/json"
  },
  "collections": {
    "color": ["primitives", "palette", "semantics"],
    "size": ["primitives", "size"],
    "typography": ["primitives", "typography"]
  },
  "modes": {
    "color": ["light", "dark"],
    "breakpoint": ["mobile", "tablet", "desktop", "desktop compact"]
  },
  "tokens": {
    "fontWeights": {
      "Light": 300,
      "Regular": 400,
      "Medium": 500,
      "Bold": 700
    },
    "pxPatterns": [
      "fontsize",
      "lineheight",
      "letterspacing",
      "space",
      "control",
      "radius",
      "stroke",
      "scale",
      "container"
    ],
    "groupValueKey": "selfvalue",
    "schemaVersion": 1
  }
}
