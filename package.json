{
  "name": "@zebra-design-system/tokens",
  "version": "0.3.0",
  "description": "Zebra Design System design tokens: the DTCG source of truth exported from Figma, plus the built CSS custom-property layers and fonts",
  "type": "module",
  "private": false,
  "files": [
    "dist",
    "bin",
    "AGENTS.md",
    "llms.txt"
  ],
  "exports": {
    "./manifest.json": "./dist/manifest.json",
    "./fonts.json": "./dist/fonts.json",
    "./base/*": "./dist/base/*",
    "./extensions/*": "./dist/extensions/*",
    "./css": "./dist/css/index.css",
    "./css/*": "./dist/css/*",
    "./css-attributes": "./dist/css-attributes/index.css",
    "./css-attributes/*": "./dist/css-attributes/*",
    "./fonts/*": "./dist/fonts/*"
  },
  "bin": {
    "zebra-theme": "./bin/zebra-theme.mjs"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs && node test/theme.check.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/multiplayer-studio/zebra-design-system.git",
    "directory": "packages/tokens"
  },
  "publishConfig": {
    "access": "public"
  },
  "distChannel": {
    "type": "git",
    "repo": "https://github.com/multiplayer-studio/zebra-design-system.git",
    "tag": "tokens-v0.3.0",
    "builtFrom": "ca3f8bc0"
  }
}
