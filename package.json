{
  "name": "zebra-design-system",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "tokens": "pnpm -r run tokens",
    "build": "pnpm -r run build && pnpm run docs:components",
    "check": "pnpm -r --filter '!@zebra-design-system/zeta-web' run check && pnpm --filter @zebra-design-system/zeta-web run check",
    "typecheck": "pnpm -r run typecheck",
    "playbook:stale": "node docs/guide/stale.mjs",
    "playbook:build": "node docs/guide/build.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && node docs/components/generate.mjs",
    "release": "pnpm -r run build && changeset publish",
    "storybook": "pnpm run storybook:react & pnpm run storybook:wc & pnpm run storybook:zeta & wait",
    "storybook:react": "pnpm --filter @zebra-design-system/react-baseui run storybook",
    "storybook:wc": "pnpm --filter @zebra-design-system/web-components run storybook",
    "storybook:zeta": "pnpm --filter @zebra-design-system/zeta-web run storybook",
    "docs:components": "node docs/components/generate.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3"
  }
}
