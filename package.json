{
  "name": "zebra-design-system",
  "private": true,
  "scripts": {
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format",
    "typecheck": "pnpm --filter @zebra-design-system/token-machine run typecheck && pnpm --filter @zebra-design-system/instructions-machine run typecheck",
    "lint": "pnpm --filter @zebra-design-system/zeta-web run lint && pnpm --filter @zebra-design-system/zeta-web run lint:lit-analyzer",
    "format": "pnpm --filter @zebra-design-system/zeta-web run prettier",
    "test": "pnpm test:tokens && pnpm test:figma && pnpm test:web",
    "clean:tokens": "pnpm --filter @zebra-design-system/token-machine run clean",
    "fetch:tokens": "pnpm --filter @zebra-design-system/token-machine run fetch",
    "convert:tokens": "pnpm --filter @zebra-design-system/token-machine run convert",
    "build:tokens": "pnpm --filter @zebra-design-system/token-machine run build",
    "pack:tokens": "pnpm --filter @zebra-design-system/tokens pack",
    "sync:tokens": "pnpm run clean:tokens && pnpm run fetch:tokens && pnpm run convert:tokens && pnpm run build:tokens",
    "test:tokens": "pnpm --filter @zebra-design-system/token-machine run test",
    "sync:design": "pnpm run build:tokens && pnpm run docs:figma",
    "docs:figma": "pnpm --filter @zebra-design-system/instructions-machine run generate",
    "test:figma": "pnpm --filter @zebra-design-system/instructions-machine run test",
    "storybook": "pnpm --filter @zebra-design-system/zeta-web run storybook",
    "test:web": "pnpm --filter @zebra-design-system/zeta-web run test",
    "docs:web:build": "pnpm --filter @zebra-design-system/zeta-web run docs:build",
    "docs:web": "pnpm --filter @zebra-design-system/zeta-web run docs",
    "docs:web:serve": "pnpm --filter @zebra-design-system/zeta-web run docs:serve"
  },
  "dependencies": {
    "style-dictionary": "^5.5.0"
  },
  "devDependencies": {
    "@nx/js": "^23.2.0",
    "@types/node": "^26.5.0",
    "nx": "23.2.0",
    "tsx": "^4.17.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "react-router-dom": "^6.3.0",
      "react-router": "^6.3.0",
      "@xmldom/xmldom": "^0.8.13",
      "picomatch": "^4.0.2",
      "undici": "^7.28.0",
      "js-yaml": "^4.3.0",
      "@puppeteer/browsers": "^3.0.0",
      "uuid": "^11.1.1",
      "@storybook/blocks>react": "^19.2.8",
      "@storybook/addon-designs>react": "^19.2.8"
    }
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e"
}
