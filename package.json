{
  "name": "zebra-design-system",
  "private": true,
  "scripts": {
    "clean:tokens": "npm run clean --workspace=tooling/token-machine",
    "fetch:tokens": "npm run fetch --workspace=tooling/token-machine",
    "convert:tokens": "npm run convert --workspace=tooling/token-machine",
    "build:tokens": "npm run build --workspace=tooling/token-machine",
    "pack:tokens": "npm pack --workspace=packages/design-system-tokens",
    "export:tokens": "npm run export --workspace=tooling/token-machine",
    "sync:tokens": "npm run clean:tokens && npm run convert:tokens && npm run build:tokens && npm run export:tokens",
    "dev:tokens-web": "npm run dev --workspace=apps/token-showcase-web",
    "dev:tokens-flutter": "cd apps/token-showcase-flutter && flutter run"
  },
  "workspaces": [
    "tooling/*",
    "packages/*",
    "packages/zebra-web",
    "apps/*"
  ],
  "dependencies": {
    "style-dictionary": "^5.5.0"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
