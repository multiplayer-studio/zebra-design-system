{
  "name": "zebra-design-system",
  "private": true,
  "scripts": {
    "clean:tokens": "yarn workspace @zebra-design-system/token-machine clean",
    "fetch:tokens": "yarn workspace @zebra-design-system/token-machine fetch",
    "convert:tokens": "yarn workspace @zebra-design-system/token-machine convert",
    "build:tokens": "yarn workspace @zebra-design-system/token-machine build",
    "pack:tokens": "yarn workspace packages/tokens pack",
    "export:tokens": "yarn workspace @zebra-design-system/token-machine export",
    "sync:tokens": "yarn clean:tokens && yarn fetch:tokens && yarn convert:tokens && yarn build:tokens && yarn export:tokens",
    "dev:tokens-web": "yarn workspace token-showcase-web dev",
    "storybook": "yarn workspace @zebra-design-system/zeta-web storybook",
    "test:web": "yarn workspace @zebra-design-system/zeta-web test"
  },
  "workspaces": [
    "tooling/*",
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "style-dictionary": "^5.5.0"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  },
  "resolutions": {
    "react-router-dom": "^6.3.0",
    "react-router": "^6.3.0",
    "@isaacs/brace-expansion": "^5.0.1",
    "@xmldom/xmldom": "^0.8.13",
    "picomatch": "^4.0.2",
    "undici": "^7.28.0",
    "js-yaml": "^4.3.0",
    "brace-expansion": "^2.1.4",
    "@puppeteer/browsers": "^3.0.0",
    "uuid": "^11.1.1"
  },
  "packageManager": "yarn@4.0.2+sha512.4e502bea682e7d8004561f916f1da2dfbe6f718024f6aa50bf8cd86f38ea3a94a7f1bf854a9ca666dd8eafcfb8d44baaa91bf5c7876e79a7aeac952c332f0e88"
}
